{
  // Read from the Figma node in the Airtable row, through the Dev Mode MCP
  // server: 3 variants x 2 sizes x 5 states, thirty symbols, which is thirty
  // test cases QA owes for this component.
  "id": "button",
  "name": "Button",
  "props": {
    "children": "ReactNode, required. The label, and the accessible name.",
    "variant": "'primary' | 'secondary' | 'ghost', default 'primary'",
    "size": "'md' | 'lg', default 'md'",
    "loading": "boolean, default false. Stays focusable, stops taking clicks.",
    "disabled": "boolean, default false. Leaves the tab order, as a disabled control does.",
    "type": "'button' | 'submit' | 'reset', default 'button'",
    "className": "string, appended to the component's own classes",
  },
  "variants": ["primary", "secondary", "ghost"],
  "sizes": ["md", "lg"],
  "states": ["default", "hover", "focus", "disabled", "loading"],
  "tokens": [
    "accent-ink",
    "accent-ink-deep",
    "accent-soft",
    "surface-card",
    "line-strong",
    "text-on-accent",
    "disabled-surface",
    "disabled-text",
    "focus-ring",
    "shadow-button",
    "space-2",
    "space-3",
    "space-4",
    "space-5",
    "space-6",
    "control-height-md",
    "control-height-lg",
    "radius-pill",
    "font-action",
    "text-sm",
    "text-lead",
    "font-weight-bold",
    "line-height-action",
    "letter-spacing-action",
    "border-width",
    "duration-fast",
    "duration-medium",
    "easing",
  ],
  "a11y": {
    "role": "button",
    "focusOrder": "One stop, in document order. Loading keeps its stop; disabled leaves the tab order, which is what disabled means. The focus ring shows on :focus-visible only, so a mouse press does not light up a ring nobody asked for.",
    "contrast": "AA",
  },
  "usage": {
    "whenToUse": "For an action the person takes on this page: sending, saving, opening a dialog. Primary for the one thing the page is for, secondary beside it, ghost where a button would otherwise shout.",
    "whenNot": "For going somewhere. That is a link, and a link is what a person expects to be able to open in a new tab. Do not use more than one primary in a single view.",
  },
  "storybookId": "ui-button--primary",
  "astroDocsUrl": "https://chawsuhlaing2209.github.io/sunim-ds/components/button",
  "version": "0.1.0",
}
